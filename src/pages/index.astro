---
import Layout from "../layouts/Layout.astro";
import Diagonals from "../components/Diagonals.astro";
import Icon from "../components/Icon.astro";
---

<Layout title="Accueil — Aumônerie Nationale Antilles Guyane">
  <!-- HERO : Pèlerinage Lourdes 2026 -->
  <section class="relative overflow-hidden bg-anag-blue-dark text-white">
    <div
      class="absolute inset-0 opacity-25 bg-cover bg-center scale-105"
      style="background-image: url('/images/cierges-lourdes.jpg')"
    ></div>
    <div class="absolute inset-0 bg-gradient-to-r from-anag-blue-dark via-anag-blue-dark/90 to-anag-blue-dark/70"></div>

    <Diagonals variant="hero" class="opacity-80" />

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
      <div class="grid lg:grid-cols-5 gap-12 items-center">
        <div class="lg:col-span-3">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-anag-gold text-anag-blue-dark text-xs font-bold uppercase tracking-wider rounded-full mb-6 shadow-lg">
            <span class="w-2 h-2 rounded-full bg-anag-red animate-pulse"></span>
            Événement phare 2026
          </span>
          <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold leading-[1.05] mb-5 drop-shadow-lg">
            Pèlerinage<br />
            <span class="text-anag-gold">des Antilles Guyane</span><br />
            <span class="font-display italic font-medium">à Lourdes</span>
          </h1>
          <p class="text-xl sm:text-2xl text-slate-100 mb-2 font-light">Du mardi 7 au dimanche 12 juillet 2026</p>
          <p class="italic text-anag-gold mb-8 text-lg border-l-2 border-anag-gold pl-4">
            « Je te salue, Marie, comblée de grâce, le Seigneur est avec toi »
          </p>
          <p class="text-slate-200 mb-10 max-w-xl">
            Présidé par <strong class="text-white">Mgr David Macaire</strong>, archevêque de Martinique.
            Sous le patronage de l'Aumônerie Nationale Antilles Guyane.
          </p>

          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="https://bipel-agence.bipel.com/antillais-lourdes2026"
              target="_blank"
              rel="noopener"
              class="group inline-flex items-center justify-center gap-2 px-7 py-4 bg-anag-gold text-anag-blue-dark font-bold rounded-md hover:bg-yellow-300 transition-all shadow-xl hover:shadow-2xl hover:-translate-y-0.5"
            >
              S'inscrire au pèlerinage
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a
              href="/pelerinages"
              class="inline-flex items-center justify-center gap-2 px-7 py-4 border-2 border-white/30 text-white font-semibold rounded-md hover:bg-white/10 hover:border-white/60 transition-colors backdrop-blur-sm"
            >
              En savoir plus
            </a>
          </div>
        </div>

        <div class="hidden lg:block lg:col-span-2">
          <div class="relative">
            <div class="absolute -inset-4 bg-anag-gold/30 blur-2xl rounded-full"></div>
            <img
              src="/images/vierge-lourdes.jpg"
              alt="Notre-Dame de Lourdes"
              class="relative rounded-lg shadow-2xl mx-auto max-h-[520px] ring-4 ring-white/20"
            />
            <div class="absolute -bottom-6 -left-6 bg-white text-anag-blue-dark p-5 rounded-lg shadow-2xl max-w-xs border-l-4 border-anag-red">
              <p class="text-xs font-bold uppercase text-anag-red tracking-wider">Contact pèlerinage</p>
              <p class="text-sm mt-2 font-semibold">anag.lourdes@gmail.com</p>
              <p class="text-sm text-slate-600">06 71 04 88 30 (sms)</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VERSET / PAROLE -->
  <section class="relative py-20 bg-anag-cream overflow-hidden">
    <img src="/images/hibiscus-rose.jpg" alt="" class="absolute -right-20 -bottom-20 w-96 opacity-20 rotate-12 pointer-events-none" />
    <img src="/images/hibiscus-multi.jpg" alt="" class="absolute -left-32 -top-10 w-80 opacity-15 -rotate-12 pointer-events-none" />
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <svg class="w-12 h-12 mx-auto text-anag-red mb-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M6.5 10c-.223 0-.437.034-.65.065.069-.232.14-.468.254-.68.114-.308.292-.575.469-.844.148-.291.409-.488.601-.737.201-.242.475-.403.692-.604.213-.21.492-.315.714-.463.232-.133.434-.28.65-.35l.539-.222.474-.197-.485-1.938-.597.144c-.191.048-.424.104-.689.171-.271.05-.56.187-.882.312-.318.142-.686.238-1.028.466-.344.218-.741.4-1.091.692-.339.301-.748.562-1.05.945-.33.358-.656.734-.909 1.162-.293.408-.492.856-.702 1.299-.19.443-.343.896-.468 1.336-.237.882-.343 1.72-.384 2.437-.034.718-.014 1.315.028 1.747.015.204.043.402.063.539l.025.168.026-.006A4.5 4.5 0 1 0 6.5 10zm11 0c-.223 0-.437.034-.65.065.069-.232.14-.468.254-.68.114-.308.292-.575.469-.844.148-.291.409-.488.601-.737.201-.242.475-.403.692-.604.213-.21.492-.315.714-.463.232-.133.434-.28.65-.35l.539-.222.474-.197-.485-1.938-.597.144c-.191.048-.424.104-.689.171-.271.05-.56.187-.882.312-.317.143-.686.238-1.028.467-.344.218-.741.4-1.091.692-.339.301-.748.562-1.05.944-.33.358-.656.734-.909 1.162-.293.408-.492.856-.702 1.299-.19.443-.343.896-.468 1.336-.237.882-.343 1.72-.384 2.437-.034.718-.014 1.315.028 1.747.015.204.043.402.063.539l.025.168.026-.006A4.5 4.5 0 1 0 17.5 10z" />
      </svg>
      <blockquote class="font-display italic text-2xl sm:text-3xl text-anag-blue-dark leading-relaxed mb-6">
        Je te salue, Marie, comblée de grâce,<br />
        le Seigneur est avec toi.
      </blockquote>
      <cite class="not-italic text-sm uppercase tracking-[0.2em] text-anag-red font-semibold">— Luc 1,28</cite>
    </div>
  </section>

  <!-- MISSION -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span class="text-anag-red font-semibold uppercase tracking-[0.2em] text-xs">Notre mission</span>
        <h2 class="text-3xl sm:text-5xl font-bold text-anag-blue-dark mt-3 mb-6 leading-tight">
          Accueillir, écouter,<br />accompagner, former
        </h2>
        <div class="w-24 h-1 bg-anag-gold mx-auto mb-6"></div>
        <p class="text-lg text-slate-600 leading-relaxed">
          L'Aumônerie Nationale Antilles Guyane est un service de l'Église catholique en France.
          Elle aide les Antillais et Guyanais vivant en métropole à s'insérer dans la vie des Églises locales.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { icon: "heart", t: "Accueil", d: "Prière, messes, enseignements et célébrations tout au long de l'année." },
          { icon: "ear", t: "Écoute", d: "Un service fraternel pour accompagner chacun dans sa vie personnelle et spirituelle." },
          { icon: "candle", t: "Pèlerinages", d: "Lourdes chaque année, rassemblement du 11 novembre à Saint-Sulpice." },
          { icon: "book", t: "Formation", d: "Groupes de prière, catéchèse, préparation aux sacrements." },
        ].map((p, i) => (
          <div class="group relative bg-white border border-anag-sand rounded-xl p-8 hover:shadow-xl transition-all hover:-translate-y-1">
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-anag-gold to-anag-red rounded-t-xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-lg bg-anag-cream text-anag-red mb-4 group-hover:bg-anag-red group-hover:text-white transition-colors">
              <Icon name={p.icon as any} class="w-7 h-7" />
            </div>
            <h3 class="text-xl font-bold text-anag-blue-dark mb-2">{p.t}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCHAINS RENDEZ-VOUS -->
  <section class="py-24 bg-gradient-to-b from-slate-50 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-12">
        <div>
          <span class="text-anag-red font-semibold uppercase tracking-[0.2em] text-xs">Agenda</span>
          <h2 class="text-3xl sm:text-5xl font-bold text-anag-blue-dark mt-3">Prochains rendez-vous</h2>
          <div class="w-24 h-1 bg-anag-gold mt-5"></div>
        </div>
        <a href="/agenda" class="hidden sm:inline-flex items-center gap-2 text-anag-blue font-semibold hover:gap-3 transition-all">
          Voir tout <span>→</span>
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {[
          {
            date: "7 au 12 juillet 2026",
            title: "Pèlerinage à Lourdes",
            img: "/images/vierge-lourdes.jpg",
            desc: "Pèlerinage des Antilles Guyane, présidé par Mgr David Macaire, archevêque de Martinique.",
            href: "/pelerinages",
            type: "Pèlerinage",
          },
          {
            date: "11 novembre 2026",
            title: "Rassemblement national",
            img: "/images/photos/rassemblement-mains-levees.jpg",
            desc: "Plus de 3 000 fidèles rassemblés à l'église Saint-Sulpice à Paris autour de l'Eucharistie.",
            href: "/agenda",
            type: "Rassemblement",
          },
          {
            date: "Décembre 2026",
            title: "Chanté Nwèl",
            img: "/images/photos/affiche-chante-nwel.jpg",
            desc: "Veillée de chants traditionnels de Noël à la crypte Saint-François d'Assise, Paris 19e.",
            href: "/agenda",
            type: "Célébration",
          },
        ].map((e) => (
          <article class="group bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-2xl transition-all hover:-translate-y-1 border border-slate-100">
            <div class="aspect-[16/10] overflow-hidden relative">
              <img src={e.img} alt={e.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
              <div class="absolute top-4 left-4 px-3 py-1 bg-anag-gold text-anag-blue-dark text-xs font-bold uppercase tracking-wider rounded-full shadow-md">
                {e.type}
              </div>
            </div>
            <div class="p-6">
              <p class="text-xs font-bold uppercase tracking-wider text-anag-red mb-2">{e.date}</p>
              <h3 class="text-xl font-bold text-anag-blue-dark mb-2 group-hover:text-anag-blue transition-colors">{e.title}</h3>
              <p class="text-sm text-slate-600 mb-4 leading-relaxed">{e.desc}</p>
              <a href={e.href} class="inline-flex items-center gap-2 text-anag-blue font-semibold text-sm group-hover:gap-3 transition-all">
                En savoir plus <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CHŒURS & COMMUNAUTÉ -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <span class="text-anag-red font-semibold uppercase tracking-[0.2em] text-xs">Communauté vivante</span>
        <h2 class="text-3xl sm:text-5xl font-bold text-anag-blue-dark mt-3 leading-tight">Chœurs, louange et fraternité</h2>
        <div class="w-24 h-1 bg-anag-gold mx-auto mt-5 mb-6"></div>
        <p class="text-lg text-slate-600 leading-relaxed">
          La musique et le chant sont au cœur de la vie spirituelle de l'ANAG. Rejoignez les répétitions,
          les veillées et les célébrations.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-4">
        <figure class="col-span-2 row-span-2 relative aspect-[4/3] md:aspect-auto overflow-hidden rounded-xl shadow-lg group">
          <img src="/images/photos/choeur-tenue-blanche.jpg" alt="Chœur de l'ANAG" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-anag-blue-dark/95 via-anag-blue-dark/40 to-transparent p-6 text-white">
            <h3 class="text-2xl font-bold">Chœur de l'ANAG</h3>
            <p class="text-sm text-slate-200 mt-1">Pour les grands rassemblements et concerts</p>
          </figcaption>
        </figure>
        <figure class="relative aspect-square overflow-hidden rounded-xl shadow-lg group">
          <img src="/images/photos/chorale-repetition.jpg" alt="Répétition chorale" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-anag-blue-dark/95 to-transparent p-4 text-white">
            <h3 class="font-bold">Répétitions</h3>
          </figcaption>
        </figure>
        <figure class="relative aspect-square overflow-hidden rounded-xl shadow-lg group">
          <img src="/images/photos/solistes-chant.jpg" alt="Solistes" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-anag-blue-dark/95 to-transparent p-4 text-white">
            <h3 class="font-bold">Ensemble Tehillah</h3>
          </figcaption>
        </figure>
      </div>

      <div class="text-center mt-10">
        <a href="/galerie" class="inline-flex items-center gap-2 text-anag-blue font-semibold hover:gap-3 transition-all">
          Voir la galerie complète <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA DON -->
  <section class="relative py-24 bg-gradient-to-br from-anag-red via-anag-red to-red-700 text-white overflow-hidden">
    <img src="/images/hibiscus-rose.jpg" alt="" class="absolute -right-16 -bottom-10 w-80 opacity-25 rotate-12" />
    <img src="/images/hibiscus-multi.jpg" alt="" class="absolute -left-20 -top-10 w-72 opacity-20 -rotate-6" />
    <div class="absolute inset-0 bg-gradient-to-r from-anag-red/95 via-anag-red/70 to-anag-red/95"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-5xl font-bold mb-6 leading-tight">Soutenez l'Aumônerie</h2>
      <p class="text-lg text-white/95 mb-10 max-w-2xl mx-auto leading-relaxed">
        Votre don permet de faire vivre les pèlerinages, l'accompagnement pastoral et les rassemblements
        de la communauté antillo-guyanaise en métropole.
      </p>
      <a
        href="/don"
        class="inline-flex items-center gap-2 px-10 py-4 bg-white text-anag-red font-bold rounded-md hover:bg-anag-cream transition-all shadow-2xl hover:-translate-y-0.5"
      >
        Faire un don
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>
</Layout>
