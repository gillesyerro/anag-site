---
import Layout from "../layouts/Layout.astro";

const events = [
  {
    date: "7 au 12 juillet 2026",
    type: "Pèlerinage",
    title: "Pèlerinage des Antilles Guyane à Lourdes",
    desc: "Sous la présidence de Mgr David Macaire, archevêque de Martinique. Thème : « Je te salue, Marie, comblée de grâce, le Seigneur est avec toi ».",
    lieu: "Sanctuaire de Lourdes",
    href: "/pelerinages",
    cta: "S'inscrire",
    featured: true,
  },
  {
    date: "11 novembre 2026",
    type: "Rassemblement",
    title: "Rassemblement national Antilles-Guyane",
    desc: "Le temps fort de l'année : plus de 3 000 fidèles originaires des Antilles-Guyane se rassemblent autour de l'Eucharistie. Messe présidée par plusieurs évêques de Guadeloupe, Martinique, Guyane et la Réunion.",
    lieu: "Église Saint-Sulpice, Paris (13h-18h)",
    affiche: "/images/photos/affiche-rassemblement-programme.jpg",
    afficheAlt: "Programme du rassemblement national Antilles-Guyane 2026",
  },
  {
    date: "Décembre 2026",
    type: "Célébration",
    title: "Chanté Nwèl",
    desc: "Veillée de chants traditionnels de Noël avec l'ANAG et les paroisses Saint-François d'Assise et Sainte-Colette. Messe anticipée 18h30, Chanté Nwèl 19h30. Repas offert par l'ANAG, apportez boissons et desserts.",
    lieu: "Crypte de Saint-François d'Assise, 7 rue de Mouzaïa, 75019 Paris",
  },
  {
    date: "22 mai 2026",
    type: "Commémoration",
    title: "Abolition de l'esclavage",
    desc: "Célébration eucharistique en mémoire des victimes de l'esclavage et en action de grâce pour l'abolition.",
    lieu: "Paris (à confirmer)",
  },
  {
    date: "Chaque dimanche",
    type: "Liturgie",
    title: "Messes dominicales",
    desc: "Messes animées par la communauté antillo-guyanaise dans différentes paroisses de métropole.",
    lieu: "Paris et Île-de-France",
  },
  {
    date: "Régulièrement",
    type: "Chœur",
    title: "Ensemble Vocal Tehillah",
    desc: "Chœur polyphonique liturgique francilien porté par des voix des Antilles et de Guyane. Recrutement permanent (sopranes, altos, ténors, basses) et instrumentistes (piano, batterie, basse, trompette). Direction : Ludovic Celma.",
    lieu: "5 bis rue de Mouzaïa, 75019 Paris",
  },
];
---

<Layout title="Agenda — ANAG">
  <section class="bg-anag-blue-dark text-white py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-anag-gold font-semibold uppercase tracking-[0.2em] text-xs">Calendrier</span>
      <h1 class="text-4xl sm:text-6xl font-bold mt-3">Agenda</h1>
      <div class="w-24 h-1 bg-anag-gold mt-5 mb-6"></div>
      <p class="text-xl text-slate-200 max-w-3xl leading-relaxed">
        Rendez-vous, célébrations et temps forts de l'Aumônerie Nationale Antilles Guyane.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      {events.map((e) => (
        <article class={`rounded-lg p-8 border-l-4 ${e.featured ? "bg-anag-gold/10 border-anag-gold shadow-md" : "bg-white border-anag-blue shadow-sm"}`}>
          <div class="flex flex-wrap items-start justify-between gap-4 mb-3">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-anag-red">{e.type}</p>
              <h3 class="text-2xl font-bold text-anag-blue-dark mt-1">{e.title}</h3>
            </div>
            <div class={`px-4 py-2 rounded-md text-sm font-bold ${e.featured ? "bg-anag-gold text-anag-blue-dark" : "bg-anag-cream text-anag-blue-dark"}`}>
              {e.date}
            </div>
          </div>
          <p class="text-slate-700 mb-3 leading-relaxed">{e.desc}</p>
          <p class="text-sm text-slate-500">📍 {e.lieu}</p>
          {e.href && (
            <a href={e.href} class="inline-block mt-4 text-anag-blue font-semibold hover:underline">
              {e.cta ?? "En savoir plus"} →
            </a>
          )}
          {e.affiche && (
            <a href={e.affiche} target="_blank" rel="noopener" class="block mt-5 rounded-md overflow-hidden border border-anag-blue/10 shadow-sm hover:shadow-md transition-shadow">
              <img src={e.affiche} alt={e.afficheAlt} class="w-full h-auto" loading="lazy" />
            </a>
          )}
        </article>
      ))}
    </div>
  </section>
</Layout>
