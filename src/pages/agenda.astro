---
import Layout from "../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

const events = await getCollection("events");

const typeOrder = ["Pèlerinage", "Rassemblement", "Célébration", "Commémoration", "Liturgie", "Chœur"];
events.sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  if (a.data.dateSort && b.data.dateSort) return a.data.dateSort.getTime() - b.data.dateSort.getTime();
  if (a.data.dateSort) return -1;
  if (b.data.dateSort) return 1;
  const ta = typeOrder.indexOf(a.data.type);
  const tb = typeOrder.indexOf(b.data.type);
  return (ta === -1 ? 99 : ta) - (tb === -1 ? 99 : tb);
});

const rendered = await Promise.all(
  events.map(async (e) => ({ ...e, Content: (await render(e)).Content }))
);
---

<Layout title="Agenda — ANAG">
  <section class="bg-anag-blue-dark text-white py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-anag-gold font-semibold uppercase tracking-[0.2em] text-xs">Calendrier</span>
      <h1 class="text-4xl sm:text-6xl font-bold mt-3">Agenda</h1>
      <div class="w-24 h-1 bg-anag-gold mt-5 mb-6"></div>
      <p class="text-xl text-slate-200 max-w-3xl leading-relaxed">
        Rendez-vous, célébrations et temps forts de l'Aumônerie Nationale Antilles Guyane.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      {rendered.map((e) => (
        <article class={`rounded-lg p-8 border-l-4 ${e.data.featured ? "bg-anag-gold/10 border-anag-gold shadow-md" : "bg-white border-anag-blue shadow-sm"}`}>
          <div class="flex flex-wrap items-start justify-between gap-4 mb-3">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-anag-red">{e.data.type}</p>
              <h3 class="text-2xl font-bold text-anag-blue-dark mt-1">{e.data.title}</h3>
            </div>
            <div class={`px-4 py-2 rounded-md text-sm font-bold ${e.data.featured ? "bg-anag-gold text-anag-blue-dark" : "bg-anag-cream text-anag-blue-dark"}`}>
              {e.data.date}
            </div>
          </div>
          <div class="text-slate-700 mb-3 leading-relaxed prose prose-sm max-w-none prose-p:my-0">
            <e.Content />
          </div>
          <p class="text-sm text-slate-500">📍 {e.data.lieu}</p>
          {e.data.href && (
            <a href={e.data.href} class="inline-block mt-4 text-anag-blue font-semibold hover:underline">
              {e.data.cta ?? "En savoir plus"} →
            </a>
          )}
          {e.data.affiche && (
            <a href={e.data.affiche} target="_blank" rel="noopener" class="block mt-5 rounded-md overflow-hidden border border-anag-blue/10 shadow-sm hover:shadow-md transition-shadow">
              <img src={e.data.affiche} alt={e.data.afficheAlt} class="w-full h-auto" loading="lazy" />
            </a>
          )}
        </article>
      ))}
    </div>
  </section>
</Layout>
