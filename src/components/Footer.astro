---
---

<footer class="relative bg-anag-blue-dark text-slate-200 mt-20 overflow-hidden">
  <!-- Diagonale décorative en haut -->
  <svg class="absolute -top-px left-0 w-full h-12" preserveAspectRatio="none" viewBox="0 0 1440 60" aria-hidden="true">
    <polygon points="0,60 1440,0 1440,15 0,60" fill="#e4b73a" opacity="0.9" />
    <polygon points="0,60 1440,15 1440,30 0,60" fill="#c9233f" opacity="0.7" />
  </svg>

  <img src="/images/hibiscus-multi.jpg" alt="" class="absolute -right-20 top-20 w-72 opacity-10 pointer-events-none" />

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <div class="md:col-span-2">
        <div class="inline-block bg-white rounded-lg p-3 mb-5 shadow-lg">
          <img src="/images/logo-anag.png" alt="ANAG" class="h-14 w-auto" />
        </div>
        <p class="text-sm leading-relaxed text-slate-300 max-w-md">
          L'Aumônerie Nationale Antilles Guyane accueille, écoute, accompagne et forme les
          Antillais et Guyanais vivant en métropole ou de passage, et favorise leur intégration
          dans la vie des Églises locales.
        </p>
      </div>

      <div>
        <h3 class="font-display text-lg text-white mb-5 relative inline-block pb-2">
          Nous contacter
          <span class="absolute bottom-0 left-0 w-10 h-0.5 bg-anag-gold"></span>
        </h3>
        <ul class="space-y-3 text-sm">
          <li class="leading-relaxed">23 rue de la Paix<br />93500 Pantin</li>
          <li>
            <a href="tel:+33675405080" class="hover:text-anag-gold transition-colors block">06 75 40 50 80</a>
            <a href="tel:+33642035238" class="hover:text-anag-gold transition-colors block">06 42 03 52 38</a>
          </li>
          <li><a href="mailto:aumonerieag@gmail.com" class="hover:text-anag-gold transition-colors break-all">aumonerieag@gmail.com</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-display text-lg text-white mb-5 relative inline-block pb-2">
          Liens
          <span class="absolute bottom-0 left-0 w-10 h-0.5 bg-anag-gold"></span>
        </h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/a-propos" class="hover:text-anag-gold transition-colors">Qui sommes-nous</a></li>
          <li><a href="/agenda" class="hover:text-anag-gold transition-colors">Agenda</a></li>
          <li><a href="/pelerinages" class="hover:text-anag-gold transition-colors">Pèlerinage Lourdes 2026</a></li>
          <li><a href="/don" class="hover:text-anag-gold transition-colors">Faire un don</a></li>
          <li>
            <a href="https://www.facebook.com/AumonerieAntillesGuyane/" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:text-anag-gold transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.79-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07" />
              </svg>
              Facebook
            </a>
          </li>
          <li>
            <a href="https://www.instagram.com/antillesguyaneaumonerie/" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:text-anag-gold transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07c-1.28.06-2.15.26-2.91.55-.79.3-1.46.72-2.13 1.38A5.88 5.88 0 0 0 .62 4.14c-.3.76-.5 1.63-.55 2.91C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.28.26 2.15.55 2.91.3.79.72 1.46 1.38 2.13a5.88 5.88 0 0 0 2.13 1.38c.76.3 1.63.5 2.91.55C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.28-.06 2.15-.26 2.91-.55.79-.3 1.46-.72 2.13-1.38a5.88 5.88 0 0 0 1.38-2.13c.3-.76.5-1.63.55-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.28-.26-2.15-.55-2.91a5.88 5.88 0 0 0-1.38-2.13A5.88 5.88 0 0 0 19.86.62c-.76-.3-1.63-.5-2.91-.55C15.67.01 15.26 0 12 0zm0 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84zm0 10.16A4 4 0 1 1 16 12a4 4 0 0 1-4 4zm6.4-11.85a1.44 1.44 0 1 0 1.44 1.44 1.44 1.44 0 0 0-1.44-1.44z"/>
              </svg>
              Instagram
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 mt-12 pt-6 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-400 gap-3">
      <p>© {new Date().getFullYear()} Aumônerie Nationale Antilles Guyane</p>
      <p>Conférence des Évêques de France</p>
    </div>
  </div>
</footer>
